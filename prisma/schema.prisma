// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id Int @id @default(1)
  username String
  firstname String
  lastname String
  email String?
  password String
}

model Products {
  id Int @id @default(autoincrement())
  productName String
  image String
  brand String?
  application String?
  details String?
  price Int
  categoryId Int
  createdAt DateTime @default(now())
  category Categories @relation(fields : [categoryId] , references : [id])
}

model Categories{
  id Int @id @default(autoincrement())
  name String
  application String?
  image String?
  products Products[]

}

model Setting {
  id Int @id @default(1)
  name String
  detail String?
  logo String
  address String
  phone String
  email String?
  workingHours String?
}






model Messages {
  id Int @id @default(autoincrement())
  name String
  phone String
  email String?
  messageSubject String
  messageText String
}

model Customers{
  id Int @id @default(autoincrement())
  name String
  mobile String
  address String? @db.LongText
  email String?
}

model Articles{
  id Int @id @default(autoincrement())
  title String
  slug String?
  summary String?
  content String @db.LongText
  image  String
  author String?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?


}

model SliderAds {
  id Int @id @default(autoincrement())
  title String
  subtitle String?
  background String
  logo String?
}

